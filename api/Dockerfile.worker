# Video Processing Worker Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install FFmpeg for video transcoding
RUN apk add --no-cache ffmpeg && \
    npm config set fund=false && \
    npm config set progress=false

# Copy package files
COPY package*.json ./

# Install dependencies including devDependencies for FFmpeg
RUN npm ci

# Copy application code
COPY . .

# Create uploads directory
RUN mkdir -p uploads/hls/1080p uploads/hls/720p uploads/hls/480p uploads/hls/360p

# Expose port (not needed for worker, but good practice)
EXPOSE 3001

# Start worker - run in background so container stays alive
CMD ["sh", "-c", "npm run worker & sleep infinity"]
